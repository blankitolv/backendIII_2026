# Entorno
NODE_ENV=development
PORT=3000

# Base de datos
MONGODB_URI=mongodb://localhost:27017/shipnow
# Solo para correr tests contra una instancia fija. Si no se setea, los tests
# usan MongoDB en memoria y nunca leen esta variable.
MONGODB_URI_TEST=mongodb://localhost:27017/shipnow_test

# Auth
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRES_IN=2h
# Token para los endpoints internos (mocks y logger) fuera de desarrollo.
INTERNAL_TOKEN=cambiar-en-produccion

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
MIME_ALLOWED_DOCUMENTS=application/pdf,image/jpeg,image/png
MIME_ALLOWED_PROOFS=application/pdf,image/jpeg,image/png,application/xml

# Mocks
MOCKS_MAX_AMOUNT=100

# Paginacion
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Rate limit global
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
# LOG_LEVEL y LOG_FORMAT se resuelven por entorno si no se setean:
# development -> debug + legible; production -> info + json; test -> error + json.
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ORIGIN=*